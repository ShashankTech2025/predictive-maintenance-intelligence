# ==============================================================================
# Git Ignore - Predictive Maintenance Intelligence
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.*
!.env.example

# Temporary test databases & backup files (DO NOT COMMIT BACKUPS)
database/*backup*.db
database/*.bak
database/test_*.db
*.db-journal
*.db-wal
*.db-shm

# Pytest / Coverage caches
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db

# Build & egg distribution artifacts
dist/
build/
*.egg-info/

