# ==============================================================================
# Environment Configuration Template
# Copy to .env and configure appropriate values for your deployment environment.
# DO NOT COMMIT ACTUAL .env WITH REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Environment ('development', 'production', or 'testing')
FLASK_ENV=production

# Cryptographic Secret Key (Generate a random 32+ character hex string in production)
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production

# Web Server Port (Defaults to 5000 locally; set dynamically by Render / HF Spaces)
PORT=5000

# SQLite Database Location (Mount to a persistent disk path in cloud deployments)
DATABASE_PATH=database/predictive_maintenance.db

# Configurable Sensor Maintenance Alert Thresholds
TOOL_WEAR_ALERT_THRESHOLD=200.0
TORQUE_ALERT_THRESHOLD=55.0
ROTATIONAL_SPEED_LOW_THRESHOLD=1300.0
TEMP_DIFF_LOW_THRESHOLD=8.0

# Risk Categorization Boundaries (Percentages)
RISK_LOW_CEILING=20.0
RISK_MEDIUM_CEILING=40.0

